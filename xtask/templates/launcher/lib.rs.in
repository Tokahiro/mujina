//! @NAME@ as Mujina's launcher: started in Xbox mode, brought to the front, watched by
//! the agent. Each `TODO` needs knowledge of the launcher (docs/new-launcher.md).

mod descriptor;
#[cfg(windows)]
mod runtime;

pub use descriptor::{@TYPE@Descriptor, @TYPE@Options, DESCRIPTOR};
#[cfg(windows)]
pub use runtime::@TYPE@Launcher;

/// @NAME@, as `crates/app/src/registry.rs` lists it.
#[cfg(windows)]
pub static PLUGIN: mujina_adapter_kit::plugin::LauncherPlugin =
    mujina_adapter_kit::plugin::LauncherPlugin {
        descriptor: &DESCRIPTOR,
        runtime: &runtime::RUNTIME,
    };
