//! @NAME@ as a device of Mujina's: a handheld whose extra buttons reach
//! Windows some other way than as key chords, such as a vendor HID report.
//!
//! Made by `cargo xtask new-device @ID@`; each `TODO` needs knowledge of the device
//! (docs/new-device.md, section 4). [`DESCRIPTOR`] builds everywhere; the buttons need Windows.

mod descriptor;
#[cfg(windows)]
mod runtime;

pub use descriptor::{@TYPE@Descriptor, DESCRIPTOR};

/// @NAME@, as `crates/app/src/registry.rs` lists it in `DEVICE_PLUGINS`.
#[cfg(windows)]
pub static PLUGIN: mujina_adapter_kit::plugin::DevicePlugin =
    mujina_adapter_kit::plugin::DevicePlugin {
        descriptor: &DESCRIPTOR,
        runtime: &runtime::RUNTIME,
    };
