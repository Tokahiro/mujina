msgctxt "SetupPage"
msgid "Advanced"
msgstr "Erweitert"

msgctxt "SetupPage"
msgid "Always restart"
msgstr "Immer neu starten"

msgctxt "SetupPage"
msgid "Applies at once in Xbox mode."
msgstr "Gilt im Xbox-Modus sofort."

msgctxt "SetupPage"
msgid "Automatic is right for almost every device."
msgstr "„Automatisch“ passt für nahezu jedes Gerät."

msgctxt "SetupPage"
msgid "Between the keys of a shortcut Mujina sends. 20 ms suits almost every game."
msgstr "Zwischen den Tasten eines Kürzels, das Mujina sendet. 20 ms passen für nahezu jedes Spiel."

msgctxt "SetupPage"
msgid "Black screen while the launcher starts"
msgstr "Schwarzer Bildschirm, während der Launcher startet"

msgctxt "SetupPage"
msgid "Capture"
msgstr "Aufzeichnen"

msgctxt "SetupPage"
msgid "Currently {}"
msgstr "Derzeit {}"

