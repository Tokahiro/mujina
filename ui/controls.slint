// Controls shared by Mujina Settings and Mujina Setup. Sizes are in `Theme.u`, which is 1 px in
// Setup: it never sets the density.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// A group of rows.
export component Card inherits Rectangle {
    in property <length> inset-x: 8 * Theme.u;
    in property <length> inset-y: 8 * Theme.u;
    in property <length> gap;
    in property <length> radius: Theme.radius-card;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: root.radius;
    VerticalLayout {
        padding-left: root.inset-x;
        padding-right: root.inset-x;
        padding-top: root.inset-y;
        padding-bottom: root.inset-y;
        spacing: root.gap;
        @children
    }
}

// How a focusable control looks when focused, pressed or disabled; its user sets the accessible
// role. `glow`: Slint has no negative shadow spread, so the design's shadow is a smaller blur.
export component FocusFrame inherits Rectangle {
    in property <bool> focused;
    in property <bool> pressed;
    in property <bool> enabled: true;
    in property <color> rest: transparent;
    in property <color> focus-fill: Theme.accent-14;
    in property <color> press-fill: Theme.accent-24;
    in property <length> focus-border: 1px;
    in property <color> rest-border: transparent;
    in property <length> rest-border-width: 1px;
    in property <length> glow: 16 * Theme.u;
    opacity: root.enabled ? 1 : 0.45;
    border-radius: Theme.radius-row;
    background: root.pressed ? root.press-fill : root.focused ? root.focus-fill : root.rest;
    border-width: root.focused ? root.focus-border : root.rest-border-width;
    border-color: root.focused ? Theme.accent-focus : root.rest-border;
    drop-shadow-blur: root.focused ? root.glow : 0px;
    drop-shadow-color: Theme.glow;
    animate background { duration: 120ms; }
}

// An outlined button with an icon. `turns` spins the icon once per increment (Check again).
export component OutlineButton inherits FocusFrame {
    in property <image> icon;
    in property <string> text;
    in property <bool> accent;
    in property <length> text-size: 18 * Theme.u;
    in property <length> icon-size: 19 * Theme.u;
    in property <int> turns;
    callback clicked();
    min-height: 54 * Theme.u;
    border-radius: Theme.radius-row;
    rest-border: root.accent ? Theme.accent : Theme.line-strong;
    rest-border-width: root.accent ? 1.5px : 1px;
    focus-border: 2px;
    focus-fill: Theme.accent-18;
    press-fill: Theme.accent-32;
    pressed: touch.pressed;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 20 * Theme.u;
        padding-right: 20 * Theme.u;
        spacing: 10 * Theme.u;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                width: root.icon-size;
                height: root.icon-size;
                source: root.icon;
                colorize: label.color;
                transform-rotation: root.turns * 360deg;
                animate transform-rotation { duration: 900ms; }
            }
        }
        label := Text {
            text: root.text;
            font-size: root.text-size;
            font-weight: 500;
            vertical-alignment: center;
            color: touch.pressed ? Theme.text : root.accent ? Theme.accent-light : Theme.text-soft;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A faint ring with a bright quarter turning on it, once every 0.8 s.
export component Spinner inherits Rectangle {
    in property <length> size: 17 * Theme.u;
    in property <color> tint: Theme.accent-focus;
    width: root.size;
    height: root.size;
    accessible-role: progress-indicator;
    Rectangle {
        border-radius: root.size / 2;
        border-width: 2px;
        border-color: Theme.accent-25;
    }
    Image {
        width: root.size;
        height: root.size;
        source: Icons.spinner-arc;
        colorize: root.tint;
        transform-rotation: Math.mod(animation-tick() / 1ms, 800) / 800 * 360deg;
    }
}
